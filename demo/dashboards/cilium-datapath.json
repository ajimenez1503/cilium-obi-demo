          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "wideLayout": true
        }
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Forwarding by direction",
        "description": "Forwarded packets grouped by ingress and egress.",
        "gridPos": {
          "x": 0,
          "y": 5,
          "w": 12,
          "h": 9
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (direction) (rate(cilium_forward_count_total{instance=~\"$instance\"}[$__rate_interval]))",
            "legendFormat": "{{direction}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "pps",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 12,
              "showPoints": "never",
              "spanNulls": true,
              "stacking": {
                "mode": "none",
                "group": "A"
              }
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "max"
            ]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
