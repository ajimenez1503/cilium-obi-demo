{
  "dashboard": {
    "id": null,
    "uid": "cilium-obi-cilium",
    "title": "Cilium Datapath and Agent Health",
    "description": "Forwarding, drops, BPF maps, endpoints, policy, controller health, and agent resources.",
    "tags": [
      "cilium-obi-demo",
      "ebpf"
    ],
    "timezone": "browser",
    "schemaVersion": 42,
    "version": 1,
    "refresh": "5s",
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "links": [
      {
        "type": "dashboards",
        "title": "Cilium + OBI dashboards",
        "tags": [
          "cilium-obi-demo"
        ],
        "asDropdown": true,
        "includeVars": false,
        "keepTime": true,
        "targetBlank": false
      }
    ],
    "templating": {
      "list": [
        {
          "name": "instance",
          "label": "Cilium endpoint",
          "type": "query",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "query": {
            "query": "label_values(cilium_version, instance)",
            "refId": "var-instance"
          },
          "definition": "label_values(cilium_version, instance)",
          "refresh": 1,
          "sort": 1,
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "current": {
            "selected": true,
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "options": []
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Forwarded packets",
        "description": "Cilium forwarded packets per second.",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 5
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(cilium_forward_count_total{instance=~\"$instance\"}[$__rate_interval]))",
            "legendFormat": "",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "pps",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "blue",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "wideLayout": true
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Datapath drops",
        "description": "Cilium datapath drops per second.",
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 5
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(cilium_drop_count_total{instance=~\"$instance\"}[$__rate_interval]))",
            "legendFormat": "",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "pps",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 0.01
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "wideLayout": true
        }
      },
      {
