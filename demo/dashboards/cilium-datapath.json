          "displayMode": "gradient",
          "showUnfilled": true,
          "valueMode": "color",
          "minVizWidth": 8,
          "minVizHeight": 16,
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ],
            "fields": ""
