      {
        "id": 4,
        "type": "stat",
        "title": "Loss or refusal rate",
        "description": "Hubble lost events plus Collector refused points and spans.",
        "gridPos": {
          "x": 18,
          "y": 0,
          "w": 6,
          "h": 5
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(hubble_lost_events_total[$__rate_interval])) + sum(rate(otelcol_receiver_refused_metric_points_total[$__rate_interval])) + sum(rate(otelcol_receiver_refused_spans_total[$__rate_interval]))",
            "legendFormat": "",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 0.001
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "wideLayout": true
        }
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Application requests and network flows",
        "description": "Application request rate and Hubble flow processing rate. Different units of work, shown together for timing correlation.",
        "gridPos": {
          "x": 0,
          "y": 5,
          "w": 12,
          "h": 9
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(http_server_request_duration_seconds_count[$__rate_interval]))",
            "legendFormat": "OBI server requests/s"
          },
          {
            "refId": "B",
            "expr": "sum(rate(hubble_flows_processed_total[$__rate_interval]))",
            "legendFormat": "Hubble flows/s"
          },
          {
            "refId": "C",
            "expr": "sum(rate(cilium_forward_count_total[$__rate_interval]))",
            "legendFormat": "Cilium forwarded packets/s"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 12,
              "showPoints": "never",
              "spanNulls": true,
              "stacking": {
                "mode": "none",
                "group": "A"
              }
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "max"
            ]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
