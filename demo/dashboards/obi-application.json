{
  "dashboard": {
    "id": null,
    "uid": "cilium-obi-application",
    "title": "OBI Application Telemetry",
    "description": "Zero-code HTTP metrics and trace-derived service relationships emitted by OBI.",
    "tags": [
      "cilium-obi-demo",
      "ebpf"
    ],
    "timezone": "browser",
    "schemaVersion": 42,
    "version": 1,
    "refresh": "5s",
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "links": [
      {
        "type": "dashboards",
        "title": "Cilium + OBI dashboards",
        "tags": [
          "cilium-obi-demo"
        ],
        "asDropdown": true,
        "includeVars": false,
        "keepTime": true,
        "targetBlank": false
      }
    ],
    "templating": {
      "list": [
        {
          "name": "service",
          "label": "OBI service",
          "type": "query",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "query": {
            "query": "label_values(http_server_request_duration_seconds_count, service_name)",
            "refId": "var-service"
          },
          "definition": "label_values(http_server_request_duration_seconds_count, service_name)",
          "refresh": 1,
          "sort": 1,
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "current": {
            "selected": true,
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "options": []
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Request rate",
        "description": "HTTP server requests observed by OBI.",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 5
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\"}[$__rate_interval]))",
            "legendFormat": "",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "blue",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "wideLayout": true
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "5xx error rate",
        "description": "Percentage of observed HTTP server requests returning a 5xx status.",
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 5
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "100 * sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",http_response_status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\"}[$__rate_interval])), 0.000001)",
            "legendFormat": "",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 5
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "wideLayout": true
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Server p95",
        "description": "95th percentile server latency across selected services.",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 6,
          "h": 5
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\"}[$__rate_interval])))",
            "legendFormat": "",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "purple",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "wideLayout": true
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Instrumented services",
        "description": "Distinct services currently emitting OBI HTTP server metrics.",
        "gridPos": {
          "x": 18,
          "y": 0,
          "w": 6,
          "h": 5
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "count(count by (service_name) (http_server_request_duration_seconds_count{service_name=~\"$service\"}))",
            "legendFormat": "",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "wideLayout": true
        }
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Request rate by service",
        "description": "HTTP server request rate split by OBI service name.",
        "gridPos": {
          "x": 0,
          "y": 5,
          "w": 12,
          "h": 9
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\"}[$__rate_interval]))",
            "legendFormat": "{{service_name}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 12,
              "showPoints": "never",
              "spanNulls": true,
              "stacking": {
                "mode": "none",
                "group": "A"
              }
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "max"
            ]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "Server latency percentiles",
        "description": "Latency distribution from the OBI HTTP server histogram.",
        "gridPos": {
          "x": 12,
          "y": 5,
          "w": 12,
          "h": 9
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.50, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\"}[$__rate_interval])))",
            "legendFormat": "p50 {{service_name}}"
          },
          {
            "refId": "B",
            "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\"}[$__rate_interval])))",
            "legendFormat": "p95 {{service_name}}"
          },
          {
            "refId": "C",
            "expr": "histogram_quantile(0.99, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\"}[$__rate_interval])))",
            "legendFormat": "p99 {{service_name}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 12,
              "showPoints": "never",
              "spanNulls": true,
              "stacking": {
                "mode": "none",
                "group": "A"
              }
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "max"
            ]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 7,
        "type": "timeseries",
        "title": "Responses by HTTP status",
        "description": "Request rate grouped by response status and service.",
        "gridPos": {
          "x": 0,
          "y": 14,
          "w": 12,
          "h": 9
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (service_name, http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\"}[$__rate_interval]))",
            "legendFormat": "{{service_name}} HTTP {{http_response_status_code}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 12,
              "showPoints": "never",
              "spanNulls": true,
              "stacking": {
                "mode": "normal",
                "group": "A"
              }
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "max"
            ]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 8,
        "type": "timeseries",
        "title": "Server and client spans",
        "description": "Compare server-side observations with downstream client calls.",
        "gridPos": {
          "x": 12,
          "y": 14,
          "w": 12,
          "h": 9
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\"}[$__rate_interval]))",
            "legendFormat": "server {{service_name}}"
          },
          {
            "refId": "B",
            "expr": "sum by (service_name) (rate(http_client_request_duration_seconds_count{service_name=~\"$service\"}[$__rate_interval]))",
            "legendFormat": "client {{service_name}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 12,
              "showPoints": "never",
              "spanNulls": true,
              "stacking": {
                "mode": "none",
                "group": "A"
              }
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "max"
            ]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 9,
        "type": "timeseries",
        "title": "Average HTTP body size",
        "description": "Average request and response body sizes calculated from OBI histograms.",
        "gridPos": {
          "x": 0,
          "y": 23,
          "w": 12,
          "h": 9
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (service_name) (rate(http_server_request_body_size_bytes_sum{service_name=~\"$service\"}[$__rate_interval])) / clamp_min(sum by (service_name) (rate(http_server_request_body_size_bytes_count{service_name=~\"$service\"}[$__rate_interval])), 0.000001)",
            "legendFormat": "request {{service_name}}"
          },
          {
            "refId": "B",
            "expr": "sum by (service_name) (rate(http_server_response_body_size_bytes_sum{service_name=~\"$service\"}[$__rate_interval])) / clamp_min(sum by (service_name) (rate(http_server_response_body_size_bytes_count{service_name=~\"$service\"}[$__rate_interval])), 0.000001)",
            "legendFormat": "response {{service_name}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 12,
              "showPoints": "never",
              "spanNulls": true,
              "stacking": {
                "mode": "none",
                "group": "A"
              }
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "max"
            ]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 10,
        "type": "bargauge",
        "title": "Busiest routes",
        "description": "Current request rate by normalized HTTP route.",
        "gridPos": {
          "x": 12,
          "y": 23,
          "w": 12,
          "h": 9
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "topk(10, sum by (service_name, http_route) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\"}[$__rate_interval])))",
            "legendFormat": "{{service_name}} {{http_route}}",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {
              "mode": "continuous-BlPu"
            }
          },
          "overrides": []
        },
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true,
          "valueMode": "color",
          "minVizWidth": 8,
          "minVizHeight": 16,
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ],
            "fields": ""
          }
        }
      },
      {
        "id": 11,
        "type": "timeseries",
        "title": "Trace-derived service edges",
        "description": "Service graph request rate generated from OBI spans in Tempo.",
        "gridPos": {
          "x": 0,
          "y": 32,
          "w": 12,
          "h": 9
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (client, server) (rate(traces_service_graph_request_total[$__rate_interval]))",
            "legendFormat": "{{client}} to {{server}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 12,
              "showPoints": "never",
              "spanNulls": true,
              "stacking": {
                "mode": "none",
                "group": "A"
              }
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "max"
            ]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 12,
        "type": "timeseries",
        "title": "Failed service edges",
        "description": "Failed service graph requests generated from OBI spans.",
        "gridPos": {
          "x": 12,
          "y": 32,
          "w": 12,
          "h": 9
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (client, server) (rate(traces_service_graph_request_failed_total[$__rate_interval]))",
            "legendFormat": "{{client}} to {{server}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 12,
              "showPoints": "never",
              "spanNulls": true,
              "stacking": {
                "mode": "none",
                "group": "A"
              }
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "max"
            ]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      }
    ]
  },
  "overwrite": true,
  "message": "Provision OBI Application Telemetry"
}
